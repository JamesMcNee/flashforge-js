{
  "name": "flashforge-js",
  "version": "0.4.1",
  "description": "A NodeJS library for interacting with the Flashforge Adventurer 5M (Pro)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json && cp ./package.json ./dist/package.json && cp ./README.md ./dist/README.md",
    "package": "npm run build && npm pack ./dist",
    "publish": "npm run build && npm publish ./dist",
    "lint": "npx prettier . --write && npx eslint ."
  },
  "dependencies": {
    "@stylistic/eslint-plugin": "^5.6.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "prettier": "3.7.4",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  },
  "keywords": [
    "flashforge",
    "adventurer",
    "3dprinter"
  ],
  "author": "James McNee",
  "license": "ISC",
  "exports": {
    ".": "./index.js"
  }
}
